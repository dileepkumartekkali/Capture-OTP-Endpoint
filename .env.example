# Copy to .env for local runs. On Render/Firebase set these as env vars, NOT in a file.
# Generate the three secrets with:  npm run genkeys

PORT=3000

# 64 hex chars (32 bytes) for AES-256-GCM.
ENCRYPTION_KEY=

# Long random secret the Android app sends in the x-api-key header.
DEVICE_API_KEY=

# A DIFFERENT long random secret the web extension sends in x-api-key.
EXTENSION_API_KEY=

# Allowed browser-extension origin(s), comma-separated.
# e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGIN=

# Seconds an OTP stays valid before it auto-expires. 1800 = 30 minutes.
OTP_TTL_SECONDS=1800
